rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public read-only content collections
    match /profile/{docId}      { allow read: if true; allow write: if isAdmin(); }
    match /about/{docId}        { allow read: if true; allow write: if isAdmin(); }
    match /skills/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /techStack/{docId}    { allow read: if true; allow write: if isAdmin(); }
    match /experience/{docId}   { allow read: if true; allow write: if isAdmin(); }
    match /research/{docId}     { allow read: if true; allow write: if isAdmin(); }
    match /services/{docId}     { allow read: if true; allow write: if isAdmin(); }
    match /github/{docId}       { allow read: if true; allow write: if isAdmin(); }
    match /socialLinks/{docId}  { allow read: if true; allow write: if isAdmin(); }
    match /settings/{docId}     { allow read: if true; allow write: if isAdmin(); }
    match /media/{docId}        { allow read: if true; allow write: if isAdmin(); }

    // Projects: public reads published only; admin reads/writes everything
    match /projects/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Contact messages: anyone can create (the public contact form),
    // only admin can read/update/delete (inbox management)
    match /messages/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name','email','subject','message','status','createdAt'])
                    && request.resource.data.status == 'unread';
      allow read, update, delete: if isAdmin();
    }

    // Admin allow-list: never writable from the client
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
