{
  "name": "nayeem-portfolio",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace web run dev",
    "dev:admin": "npm --workspace admin run dev",
    "dev:backend": "npm --prefix ../Backend run dev",
    "build": "npm run build:web && npm run build:admin",
    "build:web": "npm --workspace web run build",
    "build:admin": "npm --workspace admin run build",
    "typecheck": "npm --workspace web run typecheck && npm --workspace admin run typecheck",
    "install:all": "npm install && npm --prefix ../Backend install"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
